{
  "name": "omniverse-engine",
  "private": true,
  "version": "1.0.0",
  "description": "The Simulation Multiverse (Omniverse Engine) \u2014 Deterministic Multiverse Simulation Laboratory",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "verify:dist": "node scripts/verify-dist.mjs",
    "measure:baseline": "RECORD_BASELINE=1 vitest run src/test/baselineManifest.test.ts",
    "test:acceptance": "RUN_ACCEPTANCE=1 RUN_SEMANTIC_ACCEPTANCE=1 vitest run src/test/defaultBalance.test.ts src/test/semanticAcceptance.test.ts src/test/historicalArchives.test.ts",
    "fixtures:historical": "node scripts/acceptance/generate-historical.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
